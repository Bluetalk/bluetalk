{
  "name": "bluetalk",
  "version": "1.1.17",
  "description": "Peer-to-peer chat app designed for stealth, performance, and restricted networks",
  "author": {
    "name": "Henny263462",
    "url": "https://github.com/Henny263462"
  },
  "main": "src/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:renderer": "node node_modules/vite/bin/vite.js",
    "dev:electron": "node scripts/dev-electron.js",
    "test": "node --test tests/*.test.js",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build": "npm run build:renderer && node node_modules/electron-builder/cli.js",
    "build:unsigned": "npm run build:renderer && node node_modules/electron-builder/cli.js --win nsis portable --config.win.signAndEditExecutable=false --publish never",
    "preview": "node node_modules/vite/bin/vite.js preview"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "vite": "^7.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.303.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.30.4",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "build": {
    "appId": "com.bluetalk.app",
    "productName": "BlueTalk",
    "icon": "assets/icon.png",
    "files": [
      "src/**/*",
      "dist/**/*",
      "assets/**/*",
      "!node_modules/@rollup/rollup-linux*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Bluetalk",
        "repo": "bluetalk",
        "releaseType": "release"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BlueTalk"
    },
    "portable": {
      "artifactName": "BlueTalk-Portable-${version}.exe"
    }
  }
}
